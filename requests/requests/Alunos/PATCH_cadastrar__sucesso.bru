meta {
  name: PATCH_cadastrar__sucesso
  type: http
  seq: 3
}

patch {
  url: http://localhost/bookbox/api/alunos/editar/{{id_aluno_valido}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{id_alunos_valido}}",
    "nome": "{{nome_valido}}",
    "cpf": "{{cpf_valido}}",
    "email": "{{email_valido}}",
    "telefone": "{{telefone_valido}}"
  }
  
}
