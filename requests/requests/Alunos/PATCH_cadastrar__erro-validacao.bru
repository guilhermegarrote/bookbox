meta {
  name: PATCH_cadastrar__erro-validacao
  type: http
  seq: 4
}

patch {
  url: http://localhost/bookbox/api/alunos/editar/{{id_aluno_invalido}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{id_alunos_invalido}}",
    "nome": "{{nome_invalido}}",
    "cpf": "{{cpf_invalido}}",  
    "email": "{{email_invalido}}",  
    "telefone": "{{telefone_invalido}}"
  }
  
}
