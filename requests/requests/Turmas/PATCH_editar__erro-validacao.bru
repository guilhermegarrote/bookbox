meta {
  name: PATCH_editar__erro-validacao
  type: http
  seq: 4
}

patch {
  url: http://localhost/bookbox/api/turmas/editar{{id_turmas_invalido}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{id_turmas_invalido}}",
    "curso": "{{curso_invalido}}",
    "horario": "{{horario_invalido}}",
    "regime": "{{regime_invalido}}",
    "data_inicio": "{{data_inicio_invalida}}",
    "data_fim": "{{data_fim_invalida}}"
  }
  
}
