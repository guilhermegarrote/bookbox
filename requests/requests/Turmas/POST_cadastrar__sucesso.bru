meta {
  name: POST_cadastrar__sucesso
  type: http
  seq: 1
}

post {
  url: http://localhost/bookbox/api/turmas/cadastrar
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "curso": "{{curso_valido}}",
    "horario": "{{horario_valido}}",
    "regime": "{{regime_valido}}",
    "data_inicio": "{{data_inicio_valida}}",
    "data_fim": "{{data_fim_valida}}"
  }
  
}
