meta {
  name: POST_cadastrar__sucesso
  type: http
  seq: 1
}

post {
  url: http://localhost/bookbox/api/livros/cadastrar
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "isbn": "{{isbn_valido}}",
    "titulo": "{{titulo_valido}}",
    "autor": "{{autor_valido}}",
    "genero": "{{nome_genero_valido}}",
    "editora": "{{editora_valida}}"
  }
  
}
