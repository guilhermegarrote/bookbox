meta {
  name: PATCH_editar__sucesso
  type: http
  seq: 3
}

patch {
  url: http://localhost/bookbox/api/livros/editar/{{id_livro_valido}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{id_livro_valido}}",
    "isbn": "{{isbn_valido2}}",
    "titulo": "{{titulo_valido}}",
    "autor": "{{autor_valido2}}",
    "genero": "{{nome_genero_valido2}}",
    "editora": "{{editora_valida2}}"
  }
  
}
