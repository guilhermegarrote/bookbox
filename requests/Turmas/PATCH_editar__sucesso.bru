meta {
  name: PATCH_editar__sucesso
  type: http
  seq: 3
}

patch {
  url: http://localhost/bookbox/api/turmas/editar
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{idTurmasValido}}", 
    "curso": "{{cursoValido}}",
    "horario": "{{horarioValido}}",
    "regime": "{{regimeValido}}",
    "dataInicio": "{{dataInicioValida}}",
    "dataFim": "{{dataFimValida}}"
  }
}
