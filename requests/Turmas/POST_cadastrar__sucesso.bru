meta {
  name: POST_cadastrar__sucesso
  type: http
  seq: 1
}

post {
  url: http://localhost/bookbox/api/turmas/cadastrar
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "curso": "{{cursoValido}}",
    "horario": "{{horarioValido}}",
    "regime": "{{regimeValido}}",
    "dataInicio": "{{dataInicioValida}}",
    "dataFim": "{{dataFimValida}}"
  }
}
